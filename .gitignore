# Godot 4
.godot/
/android/
*.translation
# Dışa aktarma çıktıları
# NOT: "build/" degil "build/*". Git yok saydigi DIZINE hic inmiyor,
# o yuzden dizinin kendisi yok sayilirken alttaki istisna calismaz.
build/*
# Godot'nun disari aktarma ciktisini yeniden ICE AKTARMASINI engelleyen
# isaret dosyasi depoda kalmali. Olmazsa .godot/ sisiyor ve gecmiste pck
# de sismisti; taze klonda kimse elle olusturmayi hatirlamaz.
!build/.gdignore
*.exe
*.pck
*.zip
# Sistem
.DS_Store
Thumbs.db
